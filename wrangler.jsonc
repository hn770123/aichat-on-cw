{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aichat-on-cw",
	"main": "src/index.ts",
	// 互換日付は初期化時点で固定し、更新時にはテストを実施する。
	"compatibility_date": "2026-08-22",
	// 静的ファイルは Worker から ASSETS バインディング経由で配信する。
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// Workers AI は API トークンをコードへ保存せず、組み込みバインディングを使う。
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aichat-on-cw",
			// 実 DB の ID はコミットせず、D1 作成後にデプロイ環境で置き換える。
			"database_id": "00298bb2-c995-4503-8b17-5a79032c5a0a",
			"migrations_dir": "migrations"
		}
	]
}